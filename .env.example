# Local development only. Copy to .env and replace the sample password.
# Never reuse these values in production.
POSTGRES_DB=qualityops
POSTGRES_USER=qualityops_dev
POSTGRES_PASSWORD=replace_with_a_local_only_password
POSTGRES_PORT=5432
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
DATABASE_URL=postgresql://qualityops_dev:replace_with_a_local_only_password@localhost:5432/qualityops
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
