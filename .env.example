# ==============================================================================
# QualityOps Environment Variables (.env.example)
# Copy this file to .env and replace placeholder passwords for local development.
# NEVER commit .env to version control or reuse dev passwords in production.
# ==============================================================================

# Database (PostgreSQL 18)
POSTGRES_DB=qualityops
POSTGRES_USER=qualityops_dev
POSTGRES_PASSWORD=replace_with_a_local_only_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qualityops_dev:replace_with_a_local_only_password@127.0.0.1:5432/qualityops

# Database Connection Pool
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# Server & Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Authentication & Security (Phase 3)
# In production, secrets must be set to random cryptographic strings of at least 32 characters
JWT_ACCESS_SECRET=replace_with_a_secure_jwt_secret_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret_min_32_characters

# Python SPC Analytics Service (Phase 9)
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_TIMEOUT_MS=5000

# Reporting, Exports & Operational Alerts (Phase 10)
REPORT_STORAGE_DIR=local-data/reports
ALERT_INSPECTION_FAILURE_THRESHOLD=0.10
ALERT_EVALUATION_LOOKBACK_DAYS=7

# Notification Engine & Email Delivery (Phase 12)
EMAIL_ENABLED=false
EMAIL_MOCK_DELIVERY=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_CONNECTION_TIMEOUT_MS=5000
EMAIL_FROM="QualityOps Notifications <notifications@qualityops.local>"
EMAIL_MAX_ATTACHMENT_SIZE_BYTES=10485760
EMAIL_MAX_RETRY_ATTEMPTS=3
