{
  "name": "qualityops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build:contracts && concurrently -n \"api,web,analytics\" -c \"blue,green,magenta\" \"npm run dev -w @qualityops/api\" \"npm run dev -w @qualityops/web\" \"npm run dev:analytics\"",
    "dev:analytics": "python -m uvicorn app.main:app --app-dir services/analytics --host 127.0.0.1 --port 8000 --reload",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "build:contracts": "npm run build -w @qualityops/contracts",
    "typecheck": "npm run build:contracts && npm run typecheck -w @qualityops/contracts && npm run typecheck -w @qualityops/api && npm run typecheck -w @qualityops/web",
    "test:analytics": "python -m pytest services/analytics",
    "test": "npm run build:contracts && npm run test:analytics && npm run test --workspaces --if-present",
    "build": "npm run build:contracts && npm run build -w @qualityops/api && npm run build -w @qualityops/web",
    "db:migrate": "node-pg-migrate --migrations-dir database/migrations up",
    "db:migrate:down": "node-pg-migrate --migrations-dir database/migrations down 1",
    "db:migrate:status": "node-pg-migrate --migrations-dir database/migrations up --dry-run",
    "db:migrate:create": "node-pg-migrate --migrations-dir database/migrations --migration-file-language sql create",
    "db:migrate:redo": "node-pg-migrate --migrations-dir database/migrations redo",
    "db:bootstrap-admin": "tsx apps/api/src/scripts/bootstrap-admin.ts",
    "db:reset-admin-password": "tsx apps/api/src/scripts/reset-admin-password.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.26.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  }
}
